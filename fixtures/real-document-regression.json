{
  "schema": "poct.real_document_regression.v1",
  "description": "Local-only real document regression manifest. The files live under local-data and must stay out of git.",
  "cases": [
    {
      "id": "excel-ba512-english-smoke",
      "documentKind": "excel",
      "targetLang": "English",
      "description": "Real multi-sheet Excel baseline: parse, quality-check, export, and preserve sheet count.",
      "localPaths": {
        "source": "local-data/excel/source/BA512-AI版-兽-白细胞全-20250107.xlsx",
