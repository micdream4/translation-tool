{
  "name": "copy-of-poct-medical-document-translator",
  "private": true,
  "version": "0.3.7",
  "type": "module",
  "scripts": {
    "prepare:terminology": "node scripts/generateTerminologyAssets.mjs",
    "dev": "npm run prepare:terminology && vite",
    "build": "npm run prepare:terminology && vite build",
    "preview": "vite preview",
    "agent:translate": "node --import tsx scripts/agentTranslate.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/regressionSmoke.mjs && npm run test:agent && npm run test:rules",
    "test:agent": "node --import tsx --test scripts/agentTranslateSmoke.mjs",
    "test:rules": "node --import tsx --test scripts/ruleSystemSmoke.mjs",
    "test:rule-golden": "node --import tsx scripts/ruleGoldenEval.mjs",
    "qa-feedback:pull": "node --import tsx scripts/qaFeedback.mjs pull",
    "qa-feedback:mark-reviewed": "node --import tsx scripts/qaFeedback.mjs mark-reviewed",
    "rule:golden:build": "node scripts/buildRuleGolden.mjs",
    "test:issue-regression": "node scripts/issueRegressionSmoke.mjs",
    "test:real-docs": "node scripts/realDocumentSmoke.mjs",
    "test:ci-gate": "npm run typecheck && npm test && npm run test:rule-golden && npm run test:issue-regression && npm run build",
    "test:quality-gate": "npm run test:ci-gate && npm run test:real-docs -- --strict",
    "issue:prepare": "node scripts/prepareLocalIssueWorkspace.mjs",
    "debug:to-regression": "node scripts/debugPackageToRegression.mjs",
    "deepseek:test": "node scripts/deepseekTest.mjs",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name translation-tool"
  },
  "dependencies": {
    "@embedpdf/fonts-sc": "^1.0.0",
    "@google/genai": "^1.34.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@xmldom/xmldom": "^0.9.10",
    "docx": "^9.6.1",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wrangler": "^4.40.2"
  }
}
